<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Scheduled Job to Retry Failed Syncs -->
    <record id="ir_cron_google_calendar_sync_retry" model="ir.cron">
        <field name="name">Google Calendar Sync: Retry Failed</field>
        <field name="model_id" ref="model_meeting_room_booking"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_failed_sync()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Scheduled Job to Proactively Auto-Refresh Token -->
    <record id="ir_cron_google_calendar_token_refresh" model="ir.cron">
        <field name="name">Google Calendar Sync: Auto-Refresh Token</field>
        <field name="model_id" ref="model_meeting_room_booking"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_google_token()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
