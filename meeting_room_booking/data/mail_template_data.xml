    <!-- Meeting Cancelled Template -->
    <record id="email_template_meeting_cancelled" model="mail.template">
        <field name="name">Meeting Cancelled</field>
        <field name="model_id" ref="meeting_room_booking.model_meeting_room_booking"/>
        <field name="subject">Meeting Cancelled: {{ object.purpose }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px; line-height: 1.5;">
                <p>Hello,</p>
