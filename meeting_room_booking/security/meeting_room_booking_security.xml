<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_meeting_room_category" model="ir.module.category">
            <field name="name">Meeting Room Booking</field>
            <field name="sequence">10</field>
        </record>

        <record id="res_groups_privilege_meeting_room" model="res.groups.privilege">
            <field name="name">Meeting Rooms</field>
            <field name="category_id" ref="module_meeting_room_category"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_meeting_room_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_meeting_room"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_meeting_room_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_meeting_room"/>
            <field name="implied_ids" eval="[(4, ref('group_meeting_room_user'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="rule_meeting_room_booking_user" model="ir.rule">
            <field name="name">Users: Own Bookings Only</field>
            <field name="model_id" ref="model_meeting_room_booking"/>
            <field name="domain_force">['|', ('organizer_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_meeting_room_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_meeting_room_booking_manager" model="ir.rule">
            <field name="name">Managers: All Bookings</field>
            <field name="model_id" ref="model_meeting_room_booking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_meeting_room_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
