<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_id_card" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.id.card</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block title="ID Card Settings" id="id_card_settings_block">
                    <setting string="Employee ID Cards" help="Set authorized signature and emergency contact for printed ID cards.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="company_emergency_contact" class="col-lg-3 o_light_label"/>
                                <field name="company_emergency_contact" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label for="company_fax" class="col-lg-3 o_light_label"/>
                                <field name="company_fax" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label for="authorized_signature" class="col-lg-3 o_light_label"/>
                                <field name="authorized_signature" widget="image" class="oe_inline" options="{'size': [150, 60]}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
